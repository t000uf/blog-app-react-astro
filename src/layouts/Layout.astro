---
import ClientRouter from "astro/components/ClientRouter.astro";

import "../styles/global.css";
import Header from '@components/Header';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>にゃずろぐ</title>
		<ClientRouter />
	</head>
	<body class="size-full bg-bg-main font-(family-name:--main-text)">
		<Header></Header>
		<div class="main-wrapper flex justify-center size-full p-3.5">
			<div class="content-body flex-1 max-w-10/12 lg:max-w-5xl lg:w-10/12 mt-15">
				<slot />
			</div>
		</div>
	</body>
</html>
