---
import Layout from '@/layouts/Layout.astro';
import { WaveBand } from '@/components';
---

<Layout title="ページが見つかりません">
  <WaveBand topSeed={7} bottomSeed={4}>
    <section class="not-found">
      <p class="code">404</p>
      <h1 class="heading">ページが見つかりません</h1>
      <p class="lead">お探しのページは削除されたか、URLが変更された可能性があります。</p>
      <a href="/" class="home-link">← ホームへ戻る</a>
    </section>
  </WaveBand>
</Layout>

<style>
  @reference "@/styles/global.css";

  .not-found {
    /* 帯(WaveBand)の上に直接置くので、面・角丸・影は持たない */
    @apply flex flex-col items-center py-8 text-center md:py-12;
  }

  .code {
    @apply text-text-sub font-mono text-6xl font-bold md:text-7xl;
  }

  .heading {
    @apply font-heading text-text mt-4 text-xl font-bold md:text-2xl;
  }

  .lead {
    @apply text-text-sub mt-3 leading-relaxed;
  }

  .home-link {
    /* ピルのボタンではなく、記事詳細の「← ホームへ」と同じ下線付きの文字リンク */
    @apply hover:text-teal-strong mt-6 underline transition-colors duration-300;
  }
</style>
