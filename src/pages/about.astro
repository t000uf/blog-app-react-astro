---
import { client, type About } from '@/lib/microcms';
import { formatDate, resizeMicrocmsImages } from '@/lib/utils';
import Layout from '@/layouts/Layout.astro';

// オブジェクト形式APIなので、レスポンスがそのまま単一オブジェクト
const about = (await client.get({ endpoint: 'about' })) as About;
const date = formatDate(about.updatedAt);
---

<Layout
  title={about.title}
  description={`${about.title}`}
  publishedTime={new Date(about.updatedAt).toISOString()}
>
  <article class="bg-surface rounded-panel box-border p-4 shadow-lg md:p-6">
    <h1 class="font-heading text-text mb-4 text-2xl font-bold md:text-3xl">
      {about.title}
    </h1>
    <p class="text-right text-sm">{date} 更新</p>
    <div class="wrap-break-word prose max-w-none" set:html={resizeMicrocmsImages(about.body)} />
  </article>
</Layout>
