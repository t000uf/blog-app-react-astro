---
import '@/styles/global.css';
import { client } from '@/lib/microcms.js';
import { type Blog } from '@/lib/microcms.ts';

import Layout from '@/layouts/Layout.astro';
import { ArticleHero } from '@/components/ArticleHero';
import { ArticleBody } from '@/components/ArticleBody';
import { TableOfContents } from '@/components/TableOfContents';

export async function getStaticPaths() {
  const response = await client.get({ endpoint: 'blog' });
  return response.contents.map((blog: Blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: Blog };
---

<Layout
  title={blog.title}
  description={blog.description}
  image={blog.thumbnail?.url}
  type="article"
  publishedTime={new Date(blog.updatedAt).toISOString()}
>
  <main>
    <a
      href="/"
      class="hover:text-teal-strong mb-3 inline-block underline transition-colors duration-300"
      >← 記事一覧へ</a
    >
    <ArticleHero {blog} />
    <div class="articleWithToc">
      <ArticleBody description={blog.description} content={blog.content} author={blog.author} />
      <TableOfContents blogId={blog.id} title={blog.title} contents={blog.content} client:load />
    </div>
  </main>
</Layout>

<style>
  @reference "@/styles/global.css";

  .articleWithToc {
    @apply flex w-full flex-col-reverse justify-between gap-4 lg:flex-row lg:gap-5;
  }
</style>
