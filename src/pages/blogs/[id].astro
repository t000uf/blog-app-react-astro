---
import '@/styles/global.css';
import { client, type Blog } from '@/lib/microcms';
import { highlightCodeBlocks } from '@/lib/highlight';

import Layout from '@/layouts/Layout.astro';
import { DetailPage } from '@/components';

export async function getStaticPaths() {
  const response = await client.get({ endpoint: 'blog', queries: { limit: 100 } });
  return response.contents.map((blog: Blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: Blog };
// コードブロックのシンタックスハイライトはビルド時(Astro側)に適用してから島へ渡す
const content = await highlightCodeBlocks(blog.content);
// アソシエイトタグは公開値だがenvで一元管理する。ビルド時に読んでpropsで島へ渡す（Issue #55）。
const associateTag = import.meta.env.AMAZON_ASSOCIATE_TAG;
---

<Layout
  title={blog.title}
  description={blog.description}
  image={blog.thumbnail?.url}
  type="article"
  publishedTime={new Date(blog.updatedAt).toISOString()}
>
  <DetailPage blog={{ ...blog, content }} associateTag={associateTag} client:load />
</Layout>
