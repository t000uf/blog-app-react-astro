---
import '@/styles/global.css';
import { client } from '@/lib/microcms.js';
import { type Blog } from '@/lib/microcms.ts';
import { formatDate } from '@/lib/utils';

import Layout from '@/layouts/Layout.astro';
import { TableOfContents } from '@/components/TableOfContents';

export async function getStaticPaths() {
  const response = await client.get({ endpoint: 'blog' });
  return response.contents.map((blog: Blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: Blog };
---

<!doctype html>
<html>
  <head>
    <title>{blog.title} | 〇〇ぶろぐ</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /></head
  >

  <body>
    <Layout>
      <main class="">
        <div class="thumbnailWrapper">
          <img
            src={blog.thumbnail?.url ? `${blog.thumbnail.url}?w=800&fm=webp` : ''}
            alt=""
            loading="lazy"
            decoding="async"
            class="thumbnailImg"
          />
          <div class="p-5">
            <h1 class="text-3xl font-bold">{blog.title}</h1>
            <p class="">{formatDate(blog.publishedAt)}</p>
          </div>
        </div>
        <div class="articleWithToc">
          <article class="articleWrapper">
            <h2 class="text-xl">概要</h2>
            <p>{blog.description}</p>
            <h2 class="text-xl">本文</h2>
            <div set:html={blog.content} />
          </article>
          <TableOfContents
            blogId={blog.id}
            title={blog.title}
            contents={blog.content}
            client:load
          />
        </div>
      </main>
    </Layout>
  </body>
</html>

<style>
  @reference "@/styles/global.css";

  .thumbnailWrapper {
    @apply bg-sub-pink mb-5 box-border overflow-hidden rounded-2xl opacity-75;
  }

  .thumbnailImg {
    @apply aspect-video w-full bg-blue-400 object-cover;
  }

  .articleWithToc {
    @apply flex w-full flex-col-reverse justify-between gap-2.5 lg:flex-row lg:gap-5;
  }

  .articleWrapper {
    @apply prose box-border max-w-none rounded-2xl bg-slate-100 p-6 opacity-75 lg:max-w-8/12;
  }
</style>
