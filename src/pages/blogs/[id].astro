---
import '@/styles/global.css';
import { client, type Blog } from '@/lib/microcms';

import Layout from '@/layouts/Layout.astro';
import { DetailPage } from '@/components';

export async function getStaticPaths() {
  const response = await client.get({ endpoint: 'blog' });
  return response.contents.map((blog: Blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: Blog };
---

<Layout
  title={blog.title}
  description={blog.description}
  image={blog.thumbnail?.url}
  type="article"
  publishedTime={new Date(blog.updatedAt).toISOString()}
>
  <DetailPage blog={blog} client:load />
</Layout>
