---
import "@/styles/global.css";
import { client } from '../../lib/microcms.js';
import Layout from '../../layouts/Layout.astro';import { type Blog } from '../../lib/microcms.ts';
import { formatDate } from '@/lib/utils';

export async function getStaticPaths() {
  const response = await client.get({ endpoint: "blog" });
  return response.contents.map((blog: Blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { blog } = Astro.props as { blog: Blog };
---

<!DOCTYPE html>
<html>
  <head>
    <title>{blog.title} | にゃずろぐ</title>
    <meta charset="UTF-8" />
  </head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <body>
    <Layout>
      <main class="">
        <div class="bg-sub-pink rounded-2xl box-border opacity-75 mb-5 overflow-hidden">
          <img 
            src={blog.thumbnail?.url ? `${blog.thumbnail.url}?w=800&fm=webp` : ""}
            alt=""
            loading="lazy"
            decoding="async"
            class="w-full aspect-video bg-blue-400 object-cover"
          />
          <div class="p-5">
            <h1 class="text-3xl font-bold">{blog.title}</h1>
            <p class="">{formatDate(blog.publishedAt)}</p>
          </div>
        </div>
        <article class="prose prose-lg max-w-none">
          <div class="bg-slate-100 rounded-2xl p-6 box-border opacity-75">
          <h2 class="text-xl">概要</h2>
          <p>{blog.description}</p>
          <h2 class="text-xl">本文</h2>
          <div set:html={blog.content} />
          </article>
        </div>
      </main>
    </Layout>
  </body>
</html>
