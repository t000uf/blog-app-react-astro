---
import { IndexPage } from '@components/IndexPage';
import { client } from '@lib/microcms';
import Layout from '@/layouts/Layout.astro';

// サーバー側でデータを取得
const blogsResponse = await client.get({ endpoint: 'blog' });
const blogs = blogsResponse.contents;
const admin = await client.get({
  endpoint: 'author',
  contentId: 't000uf',
  queries: { fields: 'name,profile,image' },
});
---

<Layout>
  <IndexPage {blogs} {admin} client:load />
</Layout>
