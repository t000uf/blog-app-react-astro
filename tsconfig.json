{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
    },
    "jsxImportSource": "react",
    "types": ["node"]
  }
}
